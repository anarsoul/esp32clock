# will have compiled files and executables
debug/
target/

# Editor configuration
.vscode/
.zed/
.helix/
.nvim.lua

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Ignore .DS_Store file in mac
**/.DS_Store

# Reference material, not part of this project
3rdparty/

# Local credentials for the build (WIFI_SSID, API_TOKEN, ...)
.env

# KiCad working files under adapter/: backups, lock files, per-user
# layout state, the autorouter export and the panelizer log
*-backups/
*.lck
*.kicad_prl
*.bak
temp-freerouting.dsn
panelizer.log
fp-info-cache
_autosave-*

# The first adapter project, kept on disk beside the two that replaced it
adapter/_old/

# Sound for the sampled alarm clip: source files and the PCM built from them
wav/

# ZX Spectrum tapes for the beeper clip, and the clips made from them
tap/

# Commodore 64 tunes for the SID player, and the clips made from them
sid/

# ZX Spectrum modules for the PT3 player, and the clips made from them
pt3/

# Clip packs made by scripts/mkpack.py: the default one is built by the
# CI, a local one holds music that may not be redistributed
packs/

# The lids as lid/Makefile renders them from lid/lid.scad; the ones that
# were printed are kept under their own names
lid/lid.stl
lid/lid-speaker.stl
lid/lid-template.stl

# Photographs of the printed lids
lid/pics/

# Python's bytecode cache, left by the scripts and the bench simulations
__pycache__/
